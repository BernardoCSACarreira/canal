# binaries
/bin/
/dist/
# Anchored, because a bare "canal" matches at ANY depth and Go's own layout puts the source of the
# binary in cmd/canal — an unanchored pattern silently excluded the whole package from a commit.
# `go build ./cmd/canal` from the repo root writes exactly this path and nothing else does.
/canal
*.exe

# go
*.test
*.out
coverage.*
vendor/

# local state (checkpoints, spools, embedded stores)
/.canal/
*.wal
*.db

# frontend
node_modules/
/web/dist/

# env & secrets
.env
.env.*
!.env.example

# editors / os
.DS_Store
.idea/
*.swp
